APP_NAME=Akunta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=akunta
DB_USERNAME=akunta
DB_PASSWORD=akunta

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# plan.md §30: dokumen finansial wajib berada di private storage.
FILESYSTEM_DISK=documents

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@akunta.local"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (MinIO untuk local, S3 untuk staging/production).
AWS_ACCESS_KEY_ID=akunta
AWS_SECRET_ACCESS_KEY=akunta-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=akunta-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Python AI Worker (plan.md §26). Belum dipakai sampai Phase 3, tetapi harus reachable
# sejak Phase 0.
AI_WORKER_URL=http://127.0.0.1:8001
AI_WORKER_TOKEN=local-dev-token
AI_WORKER_TIMEOUT=30

# plan.md §15: threshold confidence dapat dikonfigurasi. Nilai default disimpan sejak
# Phase 0 supaya konfigurasi tidak tersebar saat Phase 4 dikerjakan.
ACCOUNTING_AUTO_READY_THRESHOLD=0.95
ACCOUNTING_REVIEW_THRESHOLD=0.80

VITE_APP_NAME="${APP_NAME}"
